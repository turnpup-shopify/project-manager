# Upstash Redis — add these to your Vercel project environment variables too.
# Get values from: Vercel Dashboard → your project → Integrations → Upstash Redis
# (or: vercel env pull .env.local  after linking the integration)
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
